# Configuration non secrète de l'environnement de staging.
# Aucun secret ici : les identifiants du registry viennent des variables CI/CD.
DEPLOY_ENV=staging
COMPOSE_PROJECT=cargoflow-staging
PUBLIC_PORT=8081
PREVIEW_PORT=18081
# Fenêtre d'observation après bascule (secondes) avant de valider la release.
OBSERVE_SECONDS=10
