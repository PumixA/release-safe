# Configuration non secrète de l'environnement de production.
# Aucun secret ici : les identifiants du registry viennent des variables CI/CD.
DEPLOY_ENV=production
COMPOSE_PROJECT=cargoflow-production
# Point d'entrée public unique imposé par le sujet.
PUBLIC_PORT=8080
PREVIEW_PORT=18080
# Fenêtre d'observation après bascule (secondes) avant de valider la release.
OBSERVE_SECONDS=20
